@page

@model Burgers.Pages.BookingsModel
@{
    ViewData["Title"] = "Admin Bookings";
}
<h1>Admin Bookings Table</h1>
@if (Model.Bookings.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Customer Name</th>
                <th>Customer Email</th>
                <th>Customer Phone</th>
                <th>Booking Date</th>
                <th>Number of Guests</th>
                <th>Special Requests</th>
                <th>Address</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model.Bookings)
            {
                <tr>
                    <td>@booking.CustomerName</td>
                    <td>@booking.CustomerEmail</td>
                    <td>@booking.CustomerPhone</td>
                    <td>@booking.BookingDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@booking.NumberOfGuests</td>
                    <td>@booking.SpecialRequests</td>
                    <td>@booking.Address</td>
                    <td>@booking.Status</td>

                    <td>
                        @if (booking.Status == "Pending")
                        {
                            <form method="post">
                                <input type="hidden" name="id" value="@booking.Id" />
                                <button type="submit" asp-page-handler="Confirm" class="btn btn-success">Confirm</button>
                                <button type="submit" asp-page-handler="Decline" class="btn btn-danger">Decline</button>
                            </form>
                        }
                    </td>

                </tr>
            }
        </tbody>
    </table>
}
else
{

    <p>No Bookings Avaliable</p>
}
;

