{
  "Cors": {
    "AllowedOrigins": [ "https://your-production-frontend.com" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=Burgers;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "Burgers.Api",
    "Audience": "Burgers.Client",
    "ExpiryMinutes": "20"
  },
  "AllowedHosts": "*"
}
